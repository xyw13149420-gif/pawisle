# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# .env.local 按项目要求纳入版本管理：它只含 Supabase URL 与 publishable key（公开安全）
# ⚠️ 任何时候都不要把 sb_secret_ / service_role 写进这个文件
!.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# workbuddy local agent data (memory, dev screenshots)
/.workbuddy/
