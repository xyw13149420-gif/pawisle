# ─────────────────────────────────────────────────
# 茸屿 Pawisle · 环境变量模板
# 复制成 .env.local 再填值；.env.local 不进 git，也不要提交
#   cp .env.example .env.local
# ─────────────────────────────────────────────────

# 本地 Supabase 默认地址（supabase start 之后就是它）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# 从 `supabase status` 的 anon key 一栏复制过来
# 只放 anon key；service_role key 绝不能出现在这个项目里
# 新项目也可以改用 Publishable key（sb_publishable_…），两者等价
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────
# 演示模式（MVP 阶段）
#   1 = 强制演示：固定身份 + 内存数据，完全不访问 Supabase
#   删掉或注释掉 = 走真实登录
# 生产构建永远忽略它，演示数据不会进线上。
# ─────────────────────────────────────────────────
# PAWISLE_DEMO=1

# ─────────────────────────────────────────────────
# 需要在 Supabase 侧同时配置（不改代码）：
#
# 1. Authentication → URL Configuration
#      Site URL: http://localhost:3000
#      Redirect URLs: http://localhost:3000/auth/callback
#                     http://localhost:3000/auth/confirm
#
# 2. 邮件模板（任一即可）
#    A) 默认模板（走 /auth/callback 的 code 交换）→ 不需要改
#    B) token_hash 模板 → 把链接改成
#       {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=recovery&next=/reset-password
#
# 3. 想注册后立刻可用（跳过邮箱确认）
#      Authentication → Providers → Email → 关闭 Confirm email
# ─────────────────────────────────────────────────
