# ─────────────────────────────────────────────────────────────
# 茸屿 Pawisle · 本地开发环境变量
#
# ⚠️ 这个文件已按项目要求纳入 git（.gitignore 里放行了 .env.local）。
#    因此这里只允许出现「可以公开」的值：
#      ✅ NEXT_PUBLIC_SUPABASE_URL        —— 项目地址，公开
#      ✅ NEXT_PUBLIC_SUPABASE_*_KEY      —— publishable / anon，设计上就是给浏览器的
#      ❌ sb_secret_… / service_role       —— 绝不能写进本文件，会随 git 一起泄露
#
# 改完要重启 `npm run dev` 才生效
# ─────────────────────────────────────────────────────────────

# 项目地址（注意：结尾不要带 /rest/v1/，也不要加斜杠）
NEXT_PUBLIC_SUPABASE_URL=https://vtcuolbvtrzrrbiabprg.supabase.co

# Publishable key（等价于旧的 anon key，可以安全地出现在浏览器里）
# 这里只放 publishable / anon；secret / service_role 绝不能出现在这个项目里
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_90VQaVwQ73PPNW-raIJ-vw_oiyEbgi9

# ─────────────────────────────────────────────────────────────
# 演示模式开关（MVP 阶段）
#   1 = 强制走演示模式：固定演示身份 + 内存数据，完全不访问 Supabase
#   删掉或改成 0 = 走真实登录（前提是这台机器能访问 *.supabase.co）
# 生产构建永远忽略这个开关。
# ─────────────────────────────────────────────────────────────
PAWISLE_DEMO=1
